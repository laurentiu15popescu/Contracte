rules_version = '2';

// Acces doar pentru utilizatori autentificați (Firebase Auth).
// Aplicație internă single-tenant: colecțiile sunt citite global
// (users, evenimente, incasari, modele, statusContracte), de aceea
// regula este la nivel de utilizator autentificat, nu per-document.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
