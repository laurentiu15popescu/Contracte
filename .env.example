VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Doar pentru web hostat: adresa Cloudflare Worker (proxy ANAF/BNR).
# Lasă gol în dev și desktop.
VITE_PROXY_BASE=
# Token secret trimis către worker (trebuie să fie identic cu secret-ul
# PROXY_TOKEN din Cloudflare Worker). Lasă gol în dev/desktop.
VITE_PROXY_TOKEN=
